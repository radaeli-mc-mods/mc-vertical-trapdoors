{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.radaeli.verticaltrapdoors.fabric.VerticalTrapdoorsFabric"],
    "client": ["com.radaeli.verticaltrapdoors.fabric.client.VerticalTrapdoorsFabricClient"]
  },
  "mixins": [
    "verticaltrapdoors.fabric.mixins.json",
    { "config": "verticaltrapdoors.fabric.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "=${fabric_api_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=25"
  }
}
